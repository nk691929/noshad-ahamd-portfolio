# Copy to .env.local (local) and add the same names in Vercel -> Settings -> Environment Variables. Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.noshadahmad.com
GOOGLE_SITE_VERIFICATION=

# --- Contact form (optional: falls back to a mailto link when unset) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- GitHub activity block (optional) ---
GITHUB_TOKEN=

# --- Comments (Supabase) ---
# Project URL and the PUBLISHABLE key (Project Settings -> API). The publishable key is safe to be public: Row Level
# Security limits it to reading approved comments.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. The secret key bypasses RLS. Used only by the server action that stores comments. Never prefix with
# NEXT_PUBLIC_ and never put it in client code.
SUPABASE_SECRET_KEY=
# true = new comments stay hidden until you approve them in the dashboard. Default: published immediately.
COMMENTS_REQUIRE_APPROVAL=false
